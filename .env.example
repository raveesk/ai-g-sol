# GEMINI_API_KEY: Google Gemini API key required for server-side reflection and insights generation.
# Obtain this key from Google AI Studio (https://aistudio.google.com/app/apikey) or Google Cloud Secret Manager.
GEMINI_API_KEY=REPLACE_ME

# ADMIN_UIDS: Comma-separated list of Firebase Authentication user UIDs authorized for administrative operations.
# Obtain UIDs from the Firebase Console (Authentication > Users tab) for designated administrator accounts.
ADMIN_UIDS=REPLACE_ME
